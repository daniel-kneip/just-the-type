{
  "name": "just-the-type",
  "version": "0.1.0",
  "description": "TypeSpec emitter that emits plain TypeScript types",
  "keywords": [
    "typespec",
    "typespec-emitter",
    "typescript",
    "codegen",
    "types"
  ],
  "license": "MIT",
  "author": "Daniel Kneip",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daniel-kneip/just-the-type.git"
  },
  "homepage": "https://github.com/daniel-kneip/just-the-type#readme",
  "bugs": "https://github.com/daniel-kneip/just-the-type/issues",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "typespec": "./lib/main.tsp",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "lib"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "sample": "tsp compile sample",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "check:package": "publint && attw --pack . --ignore-rules cjs-resolves-to-esm",
    "check": "pnpm lint && pnpm format:check && pnpm knip && pnpm test:coverage",
    "prepack": "tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@typespec/compiler": ">=1.0.0"
  },
  "dependencies": {
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.3",
    "@eslint/js": "10.0.1",
    "@typespec/compiler": "1.13.0",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "10.5.0",
    "eslint-config-prettier": "10.1.8",
    "knip": "6.17.1",
    "prettier": "3.8.4",
    "publint": "0.3.21",
    "typescript-eslint": "8.61.1",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@12.3.4"
}
